# Never commit real credentials.
XKNOB_MAC_ID=example-host
XKNOB_MQTT_HOST=127.0.0.1
XKNOB_MQTT_PORT=18830
XKNOB_MQTT_USER=example-user
XKNOB_SSH_TUNNEL_TARGET=nas-mqtt-tunnel
XKNOB_ENABLE_ACCOUNT_POLL=0
XKNOB_ACCOUNT_POLL_SEC=300
# Optional: full path to codex executable when LaunchAgent PATH is minimal
# XKNOB_CODEX_BIN=/opt/homebrew/bin/codex
